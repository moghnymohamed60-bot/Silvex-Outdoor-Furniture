# SILVEX OUTDOOR FURNITURE — ENVIRONMENT CONFIGURATION

# Server & Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="SILVEX Outdoor Furniture"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/silvex_outdoor?schema=public"

# Authentication & JWT
JWT_SECRET="silvex_super_secret_jwt_key_outdoor_luxury_2026_prod"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="silvex_super_secret_refresh_key_outdoor_2026"

# Stripe Payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_51MockSilvexStripeKeyOutdoorLuxury001"
STRIPE_SECRET_KEY="sk_test_51MockSilvexStripeSecretKeyOutdoorLuxury001"
STRIPE_WEBHOOK_SECRET="whsec_mockSilvexWebhookSecret2026"

# Cloudinary (Media Storage)
CLOUDINARY_CLOUD_NAME="silvex-outdoor"
CLOUDINARY_API_KEY="mock_cloudinary_key"
CLOUDINARY_API_SECRET="mock_cloudinary_secret"

# -------------------------------------------------------------
# REAL EMAIL DELIVERY CONFIGURATION (Choose Option A or Option B)
# -------------------------------------------------------------

# OPTION A: Gmail SMTP (Fastest Setup)
# 1. Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Generate an App Password for "Silvex"
SMTP_SERVICE="gmail"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
EMAIL_FROM="Silvex Outdoor <your-email@gmail.com>"

# OPTION B: Custom SMTP (Brevo / SendGrid / Mailgun / AWS SES)
# SMTP_HOST="smtp.brevo.com"
# SMTP_PORT=587
# SMTP_USER="smtp-login"
# SMTP_PASS="smtp-password"
# EMAIL_FROM="Silvex Concierge <concierge@yourdomain.com>"

# OPTION C: Resend API
# RESEND_API_KEY="re_your_real_api_key"

# Admin Default Seed Credentials
ADMIN_EMAIL="admin@silvex-outdoor.com"
ADMIN_PASSWORD="SilvexAdmin2026!"
